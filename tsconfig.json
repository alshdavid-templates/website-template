{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["DOM", "ESNext"],
    "strict": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "jsxFactory": "h",
    "types": []
  }
}